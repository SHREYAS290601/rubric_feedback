# Frontend Microsoft Entra / UIUC SSO
# Copy the frontend values into frontend/.env.local.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=organizations
VITE_API_SCOPE=api://YOUR_BACKEND_APP_ID/access_as_user

# Backend auth
# Copy the backend values into backend/.env or export them in your shell.
AUTH_REQUIRED=false
MS_TENANT_ID=organizations
MS_AUTH_AUDIENCE=api://YOUR_BACKEND_APP_ID
ALLOWED_EMAIL_DOMAINS=illinois.edu,uiuc.edu

# AI provider
# Use AI_PROVIDER=mock to force deterministic local feedback.
# Use AI_PROVIDER=openai with OPENAI_API_KEY for OpenAI Responses API.
# OPENAI_URL/OPENAI_BASE_URL can point at OpenRouter or the UIUC DSRS gateway.
# For DSRS, use OPENAI_BASE_URL=https://llm.dsrs.illinois.edu/v1 and OPENAI_MODEL=openai/gpt-oss-120b.
# OPENROUTER_API_KEY, CODEX_API_KEY, and KEY are also accepted as local aliases.
# Use AI_PROVIDER=azure with Azure OpenAI endpoint/key/deployment.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CODEX_API_KEY=
KEY=
OPENAI_URL=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Observability
# LangSmith is optional. Keep API keys in your shell or deployment secret store.
# By default, traces include sanitized counts, fingerprints, guardrail decisions,
# and result metrics. Raw draft/rubric prompt tracing is opt-in.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai_sol_dev_review_drafts_proj
LANGSMITH_TRACE_RAW_PROMPTS=false
LOG_LEVEL=INFO
